# Variables para el servicio de Feedback (SMTP)
# Configurar en Render o en tu .env local (no subir secretos reales)

SMTP_SERVER=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=tu_correo@ejemplo.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM_EMAIL=tu_correo@ejemplo.com
FEEDBACK_TO_EMAIL=lorenzoroca333@gmail.com

FEEDBACK_EMAIL_MODE=smtp
FEEDBACK_RATE_LIMIT_SECONDS=60
FEEDBACK_RATE_LIMIT_MAX=3
FEEDBACK_RATE_LIMIT_DISABLED=false
